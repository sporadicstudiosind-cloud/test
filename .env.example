# =============================================================================
# Personal TLS Proxy — Configuration
# Copy this to .env and fill in your values before starting the server.
# NEVER commit .env to version control.
# =============================================================================

# Port the proxy listens on (default: 8443)
# Use 443 if you want standard HTTPS port (requires root or CAP_NET_BIND_SERVICE)
PORT=8443

# Proxy Basic Auth credentials — CHANGE THESE before deploying
# Use a strong, random password (openssl rand -base64 24)
PROXY_USER=myuser
PROXY_PASS=changeme_use_a_strong_password_here

# TLS certificate and private key (PEM format)
# Generate with: npm run gen-cert
CERT_PATH=./certs/cert.pem
KEY_PATH=./certs/key.pem

# Connection timeout in milliseconds (default: 30 seconds)
TIMEOUT_MS=30000

# Log verbosity: "verbose" (all requests) or "minimal" (errors/warnings only)
LOG_LEVEL=verbose
